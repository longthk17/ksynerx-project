# Django
SECRET_KEY=replace-with-your-local-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,cdm-service

# Service
SERVICE_NAME=cdm
APP_VERSION=1.0.0
API_VERSION=v1

# PostgreSQL ngoài Compose, publish port 5433
DB_HOST=host.docker.internal
DB_PORT=5433
DB_NAME=cdm
DB_USER=cdm_user
DB_PASSWORD=replace-with-your-database-password

# Redis / Celery
REDIS_URL=redis://host.docker.internal:6379/0
CELERY_BROKER_URL=redis://host.docker.internal:6379/0
CELERY_RESULT_BACKEND=redis://host.docker.internal:6379/1

# Inventory cùng network Compose
INVENTORY_PRODUCTS_SYNC_URL=http://inventory-service:8000/api/v1/product-query-all