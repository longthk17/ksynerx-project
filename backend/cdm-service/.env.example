# Django
SECRET_KEY=replace-with-your-local-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,inventory-service

# Service
SERVICE_NAME=inventory
APP_VERSION=1.0.0
API_VERSION=v1

# PostgreSQL ngoài Compose, publish port 5432
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=inventory
DB_USER=inventory_user
DB_PASSWORD=replace-with-your-database-password

# Redis
REDIS_URL=redis://host.docker.internal:6379/0