# CDM Service - Docker Desktop
# PostgreSQL publish trên cổng host 5433
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=cdm
DB_USER=cdm_user
DB_PASSWORD=replace-with-your-database-password

# Redis cache và Celery (broker/result backend được tạo trong settings.py)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
